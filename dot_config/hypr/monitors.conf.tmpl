{{- if eq .chezmoi.hostname "mainpc" -}}
# ----------------------------------------------------------------
# モニタ配置設定 (スケール 1.25 最適化版)
# ----------------------------------------------------------------

# 1. 左: I-O DATA EX-LDGCU271D (横置き)
# 計算: 3840 / 1.25 = 論理幅 3072px
monitor = HDMI-A-2, 3840x2160@60, 0x0, 1.25, bitdepth, 8

# 2. 中央: LG UltraWide (横置き)
# 計算: 左(3072) = 3072
monitor = HDMI-A-1, 3440x1440@60, 3072x0, 1

# 3. 右: モバイルモニタ (横置き)
# 計算: 左(3072) + 中央(3440) = 6512
monitor = DP-1, 2560x1600@60, 6512x0, 1

# 未接続時のフォールバック
monitor = , preferred, auto, 1

{{- else if eq .chezmoi.hostname "nucbox" -}}
monitor = DP-2, 2560x1600@60, 0x0, 1
monitor = , preferred, auto, 1

{{- else }}
# TODO: {{ .chezmoi.hostname }} 用のモニター設定を追加してください
monitor = ,preferred,auto,1
{{- end }}
