# Path
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
{{- if eq .chezmoi.os "darwin" }}
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
{{- end }}

# Environment
export EDITOR=nvim
export PAGER=bat
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --ansi --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc,marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8'
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_ALT_C_OPTS="--preview 'lsd --color=always --tree --depth=2 {}'"

export RIPGREP_CONFIG_PATH=~/.config/ripgrep/ripgreprc
export BAT_THEME="Catppuccin Mocha"
export DELTA_FEATURES='+side-by-side'

# History
export HISTFILE=~/.zsh_history
export HISTSIZE=50000
export SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
# Do not persist media paths passed directly to mpv.
export HISTORY_IGNORE='(mpv|/usr/bin/mpv)(| *)'
setopt COMPLETE_ALIASES

# Completion
autoload -Uz compinit && compinit

# Case-insensitive + partial-word matching (fish-like)
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'

# Plugins
# zsh-vi-mode's NEX engine batches focus reporting (ESC[I/ESC[O) with an
# immediately following bracketed paste over SSH. Use ZLE's native parser.
export ZVM_READKEY_ENGINE=zle
eval "$(sheldon source)"

# Ignore xterm focus reporting so it cannot be interpreted as vi commands.
function _zvm_ignore_focus_event() {}
zle -N _zvm_ignore_focus_event
for keymap in viins vicmd visual; do
  bindkey -M "$keymap" $'\e[I' _zvm_ignore_focus_event
  bindkey -M "$keymap" $'\e[O' _zvm_ignore_focus_event
done

# fzf-tab: fuzzy selection on Tab
zstyle ':fzf-tab:*' fzf-flags '--height=40%' '--layout=reverse' '--ansi'
zstyle ':fzf-tab:complete:*:*' fzf-preview '
  if [[ -d $realpath ]]; then
    lsd --color=always --tree --depth=2 -- $realpath 2>/dev/null
  elif [[ -f $realpath ]]; then
    bat --color=always --style=numbers --line-range=:200 -- $realpath 2>/dev/null
  fi'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'lsd --color=always --tree --depth=2 -- $realpath'

# Aliases
alias ls='lsd'
alias ll='lsd -la --git'
alias lt='lsd --tree'
alias vim='nvim'
alias cat='bat'
alias cdt='cd $(mktemp -d)'
alias d='docker'
alias dc='docker-compose'
alias dps='docker ps'
alias di='docker images'

# Tools
eval "$(starship init zsh)"
eval "$(zoxide init zsh --cmd cd)"

# Hints for modern CLI alternatives. The original command still runs.
autoload -Uz add-zsh-hook
function _modern_cli_hint() {
  emulate -L zsh
  local -a words
  words=(${(z)1})
  (( ${#words} )) || return 0

  local command_index=1
  while (( command_index <= ${#words} )); do
    case "${words[$command_index]}" in
      command|builtin|exec|noglob|nocorrect|sudo|doas)
        (( command_index++ ))
        ;;
      env)
        (( command_index++ ))
        while (( command_index <= ${#words} )) && [[ "${words[$command_index]}" == *=* ]]; do
          (( command_index++ ))
        done
        ;;
      *)
        break
        ;;
    esac
  done

  (( command_index <= ${#words} )) || return 0
  local command_name=${words[$command_index]#\\}
  local suggestion=
  local reason=
  case "$command_name" in
    cat)
      (( $+commands[bat] )) && suggestion="bat" && reason="syntax-highlighted file viewing"
      ;;
    curl)
      if (( $+commands[http] )); then
        suggestion="http"
        reason="readable HTTP requests"
      elif (( $+commands[curlie] )); then
        suggestion="curlie"
        reason="curl-compatible HTTP requests"
      fi
      ;;
    df)
      (( $+commands[duf] )) && suggestion="duf" && reason="readable disk usage"
      ;;
    dig|nslookup)
      (( $+commands[dog] )) && suggestion="dog" && reason="readable DNS lookup"
      ;;
    du)
      (( $+commands[dust] )) && suggestion="dust" && reason="visual disk usage"
      ;;
    grep)
      (( $+commands[rg] )) && suggestion="rg" && reason="fast recursive search"
      ;;
    find)
      (( $+commands[fd] )) && suggestion="fd" && reason="fast file search"
      ;;
    gzip|gunzip|tar|unzip|zip)
      (( $+commands[ouch] )) && suggestion="ouch" && reason="unified archive handling"
      ;;
    ls)
      (( $+commands[lsd] )) && suggestion="lsd" && reason="modern ls output"
      ;;
    man)
      (( $+commands[tldr] )) && suggestion="tldr" && reason="example-focused help"
      ;;
    ps)
      (( $+commands[procs] )) && suggestion="procs" && reason="readable process listing"
      ;;
    sed)
      (( $+commands[sd] )) && suggestion="sd" && reason="simple find and replace"
      ;;
    time)
      (( $+commands[hyperfine] )) && suggestion="hyperfine" && reason="command benchmarking"
      ;;
    top)
      (( $+commands[btop] )) && suggestion="btop" && reason="interactive system monitor"
      ;;
    tmux)
      (( $+commands[zellij] )) && suggestion="zellij" && reason="modern terminal workspace"
      ;;
    watch)
      (( $+commands[watchexec] )) && suggestion="watchexec" && reason="run commands on file changes"
      ;;
  esac

  [[ -n "$suggestion" ]] || return 0
  if [[ -n "$reason" ]]; then
    print -P "%F{yellow}Hint:%f '$command_name' has a modern alternative: %F{cyan}$suggestion%f ($reason)" >&2
  else
    print -P "%F{yellow}Hint:%f '$command_name' has a modern alternative: %F{cyan}$suggestion%f" >&2
  fi
  return 0
}
add-zsh-hook preexec _modern_cli_hint

# 1Password
if (( $+commands[op] )); then
  export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
  [[ -f ~/.config/op/plugins.sh ]] && source ~/.config/op/plugins.sh
  eval "$(op completion zsh)"
fi
if (( $+commands[gh] )); then
  eval "$(/usr/bin/gh completion -s zsh)"
  functions[_gh]="${functions[_gh]//\$\{words\[1\]\}//usr/bin/gh}"
fi
function zvm_after_init() {
  source <(fzf --zsh)
  # Television handles Ctrl-T smart completion for git/repo/file pickers.
  eval "$(tv init zsh)"
  # History is owned by Atuin. Load it last so Ctrl-R stays on Atuin.
  eval "$(atuin init zsh)"

  # zsh-abbr must be loaded after zsh-vi-mode has initialized keymaps.
  local zsh_abbr
  for zsh_abbr in \
    /opt/homebrew/opt/zsh-abbr@6/share/zsh-abbr/zsh-abbr.zsh \
    /opt/homebrew/share/zsh-abbr/zsh-abbr.zsh \
    /usr/local/opt/zsh-abbr@6/share/zsh-abbr/zsh-abbr.zsh \
    /usr/local/share/zsh-abbr/zsh-abbr.zsh \
    /home/linuxbrew/.linuxbrew/opt/zsh-abbr@6/share/zsh-abbr/zsh-abbr.zsh \
    /home/linuxbrew/.linuxbrew/share/zsh-abbr/zsh-abbr.zsh
  do
    if [[ -r "$zsh_abbr" ]]; then
      source "$zsh_abbr"
      bindkey -M viins " " abbr-expand-and-insert
      bindkey -M viins "^ " magic-space
      bindkey -M viins "^M" abbr-expand-and-accept
      break
    fi
  done

  # tv's generated completion treats the channel argument as a generic path.
  # Add installed channels to `tv <Tab>` while preserving its CLI completion.
  function _tv_with_channels() {
    local ret=1
    _tv "$@" && ret=0

    if (( CURRENT == 2 )); then
      local -a channels
      channels=(${(f)"$(tv list-channels 2>/dev/null)"})
      _describe -t channels 'television channel' channels && ret=0
    fi

    return ret
  }
  compdef _tv_with_channels tv

  function _tv_ghq() {
    local repo
    repo=$(tv --source-command 'ghq list' --preview-command "ls $(ghq root)/{}")
    [[ -n "$repo" ]] && cd "$(ghq root)/$repo"
    zle reset-prompt
  }
  zle -N _tv_ghq
  bindkey -M viins '^g' _tv_ghq
  bindkey -M vicmd '^g' _tv_ghq

  function _tv_nvim() {
    local file
    file=$(tv files --source-command 'fd --type f --hidden --follow --exclude .git')
    [[ -n "$file" ]] && nvim "$file"
    zle reset-prompt
  }
  zle -N _tv_nvim
  bindkey -M viins '^f' _tv_nvim
  bindkey -M vicmd '^f' _tv_nvim

  function _tv_git_branch() {
    tv git-branch
    zle reset-prompt
  }
  zle -N _tv_git_branch
  bindkey -M viins '^b' _tv_git_branch
  bindkey -M vicmd '^b' _tv_git_branch
}


# Zellij auto-start
if [[ -o interactive && -t 0 && -t 1 && -z "$ZELLIJ" && -z "$TMUX" \
      && "$TERM_PROGRAM" != *vscode* && "${ZELLIJ_AUTO_START:-1}" != 0 ]] \
      && (( $+commands[zellij] )); then
    if [[ -n "$SSH_CONNECTION" ]]; then
        exec zellij attach --create ssh
    else
        exec zellij
    fi
fi

[[ -f ~/.config/broot/launcher/bash/br ]] && source ~/.config/broot/launcher/bash/br
