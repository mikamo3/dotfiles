# Path
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
{{- if eq .chezmoi.os "darwin" }}
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
{{- end }}

# Environment
export EDITOR=nvim
export PAGER=bat
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --ansi --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc,marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8'
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_ALT_C_OPTS="--preview 'lsd --color=always --tree --depth=2 {}'"

export RIPGREP_CONFIG_PATH=~/.config/ripgrep/ripgreprc
export BAT_THEME="Catppuccin Mocha"
export DELTA_FEATURES='+side-by-side'

# History
export HISTFILE=~/.zsh_history
export HISTSIZE=50000
export SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt COMPLETE_ALIASES

# Completion
autoload -Uz compinit && compinit

# Case-insensitive + partial-word matching (fish-like)
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'

# Plugins
eval "$(sheldon source)"

# fzf-tab: fuzzy selection on Tab
zstyle ':fzf-tab:*' fzf-flags '--height=40%' '--layout=reverse' '--ansi'
zstyle ':fzf-tab:complete:*:*' fzf-preview '
  if [[ -d $realpath ]]; then
    lsd --color=always --tree --depth=2 -- $realpath 2>/dev/null
  elif [[ -f $realpath ]]; then
    bat --color=always --style=numbers --line-range=:200 -- $realpath 2>/dev/null
  fi'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'lsd --color=always --tree --depth=2 -- $realpath'

# Aliases
alias ls='lsd'
alias ll='lsd -la --git'
alias la='lsd -la --git'
alias lt='lsd --tree'
alias vim='nvim'
alias cat='bat'
alias cdt='cd $(mktemp -d)'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias d='docker'
alias dc='docker-compose'
alias dps='docker ps'
alias di='docker images'

# Tools
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

# 1Password
if (( $+commands[op] )); then
  export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
  [[ -f ~/.config/op/plugins.sh ]] && source ~/.config/op/plugins.sh
  eval "$(op completion zsh)"
fi
if (( $+commands[gh] )); then
  eval "$(/usr/bin/gh completion -s zsh)"
  functions[_gh]="${functions[_gh]//\$\{words\[1\]\}//usr/bin/gh}"
fi
function zvm_after_init() {
  source <(fzf --zsh)
  # Television handles Ctrl-T smart completion for git/repo/file pickers.
  eval "$(tv init zsh)"
  # History is owned by Atuin. Load it last so Ctrl-R stays on Atuin.
  eval "$(atuin init zsh)"

  # tv's generated completion treats the channel argument as a generic path.
  # Add installed channels to `tv <Tab>` while preserving its CLI completion.
  function _tv_with_channels() {
    local ret=1
    _tv "$@" && ret=0

    if (( CURRENT == 2 )); then
      local -a channels
      channels=(${(f)"$(tv list-channels 2>/dev/null)"})
      _describe -t channels 'television channel' channels && ret=0
    fi

    return ret
  }
  compdef _tv_with_channels tv

  function _tv_ghq() {
    local repo
    repo=$(tv --source-command 'ghq list' --preview-command "ls $(ghq root)/{}")
    [[ -n "$repo" ]] && cd "$(ghq root)/$repo"
    zle reset-prompt
  }
  zle -N _tv_ghq
  bindkey -M viins '^g' _tv_ghq
  bindkey -M vicmd '^g' _tv_ghq

  function _tv_nvim() {
    local file
    file=$(tv files --source-command 'fd --type f --hidden --follow --exclude .git')
    [[ -n "$file" ]] && nvim "$file"
    zle reset-prompt
  }
  zle -N _tv_nvim
  bindkey -M viins '^f' _tv_nvim
  bindkey -M vicmd '^f' _tv_nvim

  function _tv_git_branch() {
    tv git-branch
    zle reset-prompt
  }
  zle -N _tv_git_branch
  bindkey -M viins '^b' _tv_git_branch
  bindkey -M vicmd '^b' _tv_git_branch
}


# Zellij auto-start
if [[ $- == *i* ]] && [[ -z "$ZELLIJ" ]] && [[ "$TERM_PROGRAM" != *vscode* ]] && [[ -z "$SSH_CONNECTION" ]]; then
    exec zellij
fi

[[ -f ~/.config/broot/launcher/bash/br ]] && source ~/.config/broot/launcher/bash/br
