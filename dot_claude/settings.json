{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "language": "japanese",
  "editorMode": "vim",
  "theme": "dark",
  "tui": "fullscreen",

  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(cargo *)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(pytest *)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },

  "autoUpdatesChannel": "stable",

  "attribution": {
    "commit": "",
    "pr": ""
  },

  "env": {
    "DISABLE_AUTOUPDATER": "0"
  }
}
